{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-migrations.sh\"",
            "timeout": 10,
            "statusMessage": "Vérification des migrations Flyway"
          }
        ]
      }
    ]
  }
}
